# TradeHub - variables de entorno de ejemplo
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio.

# --- Seguridad -------------------------------------------------
# Secreto usado para firmar los JWT (HS256). Minimo 32 caracteres.
JWT_SECRET=tu_secreto_super_seguro_de_al_menos_32_caracteres

# --- Base de datos (perfil prod / docker compose) --------------
DB_NAME=tradehub
DB_USER=tradehub
DB_PASSWORD=cambia_esta_password
MYSQL_ROOT_PASSWORD=cambia_esta_root_password

# Puertos expuestos en el host
APP_PORT=8080
MYSQL_PORT=3306
